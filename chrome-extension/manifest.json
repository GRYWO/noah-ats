{
  "manifest_version": 3,
  "name": "Noah ATS — Embed Helper",
  "version": "1.3.1",
  "description": "Maakt Robin en Jobdigger bruikbaar binnen Noah ATS en importeert vacature-exports uit Jobdigger automatisch in je bellijst.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://app.recruitrobin.com/*",
    "https://*.recruitrobin.com/*",
    "https://jobdigger.nl/*",
    "https://*.jobdigger.nl/*",
    "https://noah-ats.nl/*",
    "https://*.noah-ats.nl/*"
  ],
  "permissions": [
    "declarativeNetRequest",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://noah-ats.nl/jobdigger*", "https://*.noah-ats.nl/jobdigger*"],
      "js": ["content-noah.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "robin-headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
