{
  "manifest_version": 3,
  "name": "Noah ATS — Embed Helper",
  "version": "1.1.0",
  "description": "Maakt Recruit Robin en Jobdigger bruikbaar binnen Noah ATS.",
  "host_permissions": [
    "https://app.recruitrobin.com/*",
    "https://*.recruitrobin.com/*",
    "https://jobdigger.nl/*",
    "https://*.jobdigger.nl/*",
    "https://noah-ats.nl/*",
    "https://*.noah-ats.nl/*"
  ],
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "robin-headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
