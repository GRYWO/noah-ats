{
  "manifest_version": 3,
  "name": "Noah ATS — Embed Helper",
  "version": "1.2.2",
  "description": "Maakt Robin en Jobdigger bruikbaar binnen Noah ATS en importeert Jobdigger-downloads automatisch naar de actieve kandidaat.",
  "host_permissions": [
    "https://app.recruitrobin.com/*",
    "https://*.recruitrobin.com/*",
    "https://jobdigger.nl/*",
    "https://*.jobdigger.nl/*",
    "https://noah-ats.nl/*",
    "https://*.noah-ats.nl/*"
  ],
  "permissions": [
    "declarativeNetRequest",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "robin-headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
