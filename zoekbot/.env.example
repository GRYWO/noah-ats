# Kopieer naar .env en vul in.

# Basis-URL van de ATS (productie).
NOAH_BASE_URL=https://noah-ats.nl

# Gedeeld geheim — exact dezelfde waarde als BOT_SECRET in de ATS (Vercel env).
BOT_SECRET=zet-hier-een-lang-willekeurig-geheim

# Hoe vaak op nieuwe opdrachten checken (ms).
POLL_INTERVAL_MS=5000

# Browser headless draaien (true op de server). Zet op false om mee te kijken.
HEADLESS=true

# Map met het ingelogde browserprofiel (sessie van Yorith).
ROBIN_PROFIEL_DIR=./robin-profiel

# Jobdigger zoek-dashboard (de zoek-app, niet de marketing-homepage).
JOBDIGGER_URL=https://www.jobdigger.nl/search/dashboard
